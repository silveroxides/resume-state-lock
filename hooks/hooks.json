{
  "description": "Reinitialize root sessions after context compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/resume-state-lock.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/resume-state-lock.ps1\"",
            "async": false,
            "timeoutSec": 5,
            "additionalContextLimit": 0,
            "statusMessage": "Restoring post-compaction execution safety"
          }
        ]
      }
    ]
  }
}
